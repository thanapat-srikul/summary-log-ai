[Unit]
Description=Summary Log AI Zeek Collector
After=network-online.target zeek.service
Wants=network-online.target

[Service]
Type=simple
User=zeek
Group=zeek
EnvironmentFile=/etc/summary-log-ai/collector.env
ExecStart=/usr/bin/python3 /opt/summary-log-ai/collector/zeek_collector.py
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/summary-log-ai

[Install]
WantedBy=multi-user.target
